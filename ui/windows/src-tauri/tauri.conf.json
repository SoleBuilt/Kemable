{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kemable",
  "version": "0.1.0",
  "identifier": "kemable.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kemable",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "create": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SoleBuilt",
    "copyright": "Copyright (C) 2026 Huỳnh Trung Đức. Licensed under AGPL-3.0-only.",
    "license": "AGPL-3.0-only",
    "homepage": "https://github.com/SoleBuilt/Kemable",
    "resources": { "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "both",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
