---
import Base from "../layouts/Base.astro";
import { DOWNLOAD, REPOSITORY } from "../links";
import { ENGINES as engines, FAQ, structuredData } from "../seo";

const measured = [
  { value: "2 ms", label: "to the first page of a 300,000-row join" },
  { value: "1.07 s", label: "to stream 2,000,000 rows into the grid" },
  { value: "0.13 s", label: "to sort them by a number" },
];

const features = [
  {
    tag: "Edit",
    title: ["Change cells.", "Read the SQL.", "Then save."],
    text: "Every edit shows the exact statements first, and saves all or nothing.",
    image: "/preview.webp",
    alt: "The Save 3 changes dialog lists three UPDATE statements",
    imageFirst: false,
    shadow: "#000000",
  },
  {
    tag: "Ctrl K",
    title: ["Keyboard first."],
    text: "Every connection and command, one shortcut away.",
    image: "/palette.webp",
    alt: "The command palette lists new query, connection, file and settings commands",
    imageFirst: true,
    shadow: "#000000",
  },
  {
    tag: "Light or dark",
    title: ["Quiet frame.", "Loud data."],
    text: "Black and white, so the only thing that stands out is your data.",
    image: "/hero-light.webp",
    alt: "Kemable in its light theme showing a query and its result",
    imageFirst: false,
    shadow: "#00000066",
  },
];

const cards = [
  { title: "Live tabs", text: "NOTIFY, pub/sub, Realtime and queues, as rows.", icon: "live" },
  { title: "SSH tunnels", text: "Password or key, with the host checked.", icon: "ssh" },
  { title: "Passwords stay put", text: "In Windows Credential Manager, never in a file.", icon: "lock" },
  { title: "A safe row limit", text: "It never cancels a statement that writes.", icon: "limit" },
];

const primary =
  "inline-flex h-12 items-center gap-2 rounded-[10px] bg-accent px-5.5 font-medium text-on-accent hover:text-on-accent";
const secondary = "inline-flex h-12 items-center rounded-[10px] border border-line-strong px-5.5 font-medium text-fg hover:text-fg";
const field = "h-12 rounded-[10px] border border-line-strong bg-chrome px-4 text-base text-fg outline-none focus-visible:border-fg3";
const label = "flex flex-col gap-1.5 text-[13px] text-fg3";
const landingFields = ["utm_source", "utm_medium", "utm_campaign", "gclid", "fbclid", "msclkid", "referrer"];
// The waitlist's systems: checkboxes drawn as buttons, so a person can pick one or both.
const systems = [
  { value: "macos", name: "macOS" },
  { value: "linux", name: "Linux" },
];
const toggle =
  "group flex h-12 cursor-pointer select-none items-center justify-center gap-2.5 rounded-[10px] border border-line-strong text-base font-medium text-fg2 hover:text-fg has-checked:border-fg3 has-checked:text-fg has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-ember";
---

<Base
  title="Kemable: a fast, free database client for Windows"
  description="Stream millions of rows without a stutter. A free, open-source database client for Windows: SQLite, PostgreSQL, SQL Server, Redis, Cloudflare D1 and more."
  structured={structuredData(Astro.site ?? new URL(Astro.url.origin))}
>
  <section class="relative px-6 pt-28 text-center">
    <div
      aria-hidden="true"
      class="absolute left-1/2 top-105 h-130 w-275 -translate-x-1/2 opacity-[0.22] blur-2xl"
      style="background: radial-gradient(closest-side, var(--glow), transparent);"
    >
    </div>
    <div class="relative mx-auto flex max-w-240 flex-col items-center gap-5.5">
      <a
        href={DOWNLOAD}
        class="inline-flex items-center gap-2 rounded-full border border-line-strong py-1.25 pl-1.5 pr-3 text-[13px] text-fg2"
      >
        <span class="rounded-full bg-ember px-2 py-px text-xs font-semibold text-[#0a0a0a]">New</span>
        Preview 0.1 for Windows is out →
      </a>
      <h1 class="m-0 text-[clamp(48px,8vw,96px)] font-semibold leading-[0.98] tracking-[-0.045em]">Fast is the feature.</h1>
      <p class="m-0 max-w-140 text-xl text-fg2">The database client that streams millions of rows without a stutter.</p>
      <div class="mt-1.5 flex flex-wrap justify-center gap-3">
        <a href={DOWNLOAD} class={primary}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
            ><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path></svg
          >
          Download for Windows
        </a>
        <a href={REPOSITORY} class={secondary}>Star on GitHub</a>
      </div>
      <p class="m-0 text-[13px] text-fg3">
        Free and open source · Windows x64 · <a href="#notify" class="text-fg3 underline underline-offset-[3px] hover:text-fg">macOS and Linux later</a>
      </p>
    </div>

    <div class="relative mx-auto mt-16 max-w-290">
      <div class="rounded-[14px] p-1.5" style="background: linear-gradient(180deg, var(--line-strong), transparent 70%);">
        <video
          autoplay
          muted
          loop
          playsinline
          width="1440"
          height="900"
          poster="/demo-poster.webp"
          aria-label="Kemable runs a query that returns two million rows and scrolls through them"
          class="block h-auto w-full rounded-[10px] border border-line-strong bg-[#0a0a0a] shadow-[0_40px_120px_-30px_#000000]"
        >
          <!-- H.264 only: a VP9 webm failed in GPUs' decoders (Chrome, Edge), and a
               source that fails while playing never falls back to the next one. -->
          <source src="/kemable-demo.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <section id="engines" class="px-6 pt-14">
    <div class="mx-auto flex max-w-275 flex-wrap items-center justify-center gap-x-9 gap-y-3 text-[17px] font-medium text-fg3">
      <span class="text-[13px] font-normal">Works with</span>
      {engines.map((engine) => <span>{engine}</span>)}
    </div>
  </section>

  <section aria-label="Measured" class="px-6 py-24">
    <div
      class="mx-auto grid max-w-275 gap-px overflow-hidden rounded-2xl border border-line bg-line"
      style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));"
    >
      {
        measured.map(({ value, label }) => (
          <div class="flex flex-col gap-1 bg-bg p-8">
            <span class="text-[52px] font-semibold tracking-[-0.04em] tabular-nums">{value}</span>
            <span class="text-[15px] text-fg3">{label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section id="features" class="flex flex-col gap-30 px-6">
    {
      features.map((feature) => (
        <div class:list={["mx-auto flex w-full max-w-290 items-center gap-12", feature.imageFirst ? "flex-wrap-reverse" : "flex-wrap"]}>
          <div class="flex flex-[1_1_300px] flex-col gap-3.5">
            <span class="font-mono text-[13px] text-ember">{feature.tag}</span>
            <h2 class="m-0 text-[44px] font-semibold leading-[1.05] tracking-[-0.035em]">
              {feature.title.map((line, index) => (index === 0 ? line : [<br />, line]))}
            </h2>
            <p class="m-0 text-lg text-fg2">{feature.text}</p>
          </div>
          {/* Left of the text when imageFirst; below it, as in the design, once they wrap. */}
          <img
            src={feature.image}
            alt={feature.alt}
            width="1440"
            height="900"
            loading="lazy"
            decoding="async"
            class:list={["h-auto w-full min-w-0 flex-[2_1_560px] rounded-xl border border-line-strong", { "order-first": feature.imageFirst }]}
            style={`box-shadow: 0 30px 80px -30px ${feature.shadow};`}
          />
        </div>
      ))
    }
  </section>

  <section class="px-6 pt-35">
    <div class="mx-auto grid max-w-290 gap-3" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
      {
        cards.map((card) => (
          <div class="flex flex-col gap-2 rounded-[14px] border border-line bg-chrome p-6">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--ember)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {card.icon === "live" && <path d="M2 12h3l3-8 4 16 3-8h7" />}
              {card.icon === "ssh" && [<path d="M4 17l6-6-6-6" />, <path d="M12 19h8" />]}
              {card.icon === "lock" && [<rect x="4" y="11" width="16" height="10" rx="2" />, <path d="M8 11V7a4 4 0 0 1 8 0v4" />]}
              {card.icon === "limit" && [<path d="M12 3v18" />, <path d="M3 12h18" />, <rect x="3" y="3" width="18" height="18" rx="2" />]}
            </svg>
            <h3 class="m-0 text-base font-semibold">{card.title}</h3>
            <p class="m-0 text-sm text-fg3">{card.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="questions" class="px-6 pt-35">
    <div class="mx-auto flex max-w-215 flex-col gap-8">
      <h2 class="m-0 text-center text-[44px] font-semibold leading-[1.05] tracking-[-0.035em]">Questions</h2>
      <div class="border-t border-line">
        {
          FAQ.map(({ question, answer }) => (
            <details class="group border-b border-line">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-medium [&::-webkit-details-marker]:hidden">
                <h3 class="m-0 text-lg font-medium">{question}</h3>
                <span aria-hidden="true" class="text-2xl leading-none text-fg3 transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="m-0 pb-6 text-[17px] leading-relaxed text-fg2">{answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section id="notify" class="scroll-mt-8 px-6 pt-35">
    <div class="mx-auto flex max-w-160 flex-col items-center gap-5 text-center">
      <h2 class="m-0 text-[44px] font-semibold leading-[1.05] tracking-[-0.035em]">Join the Waitlist MacOS and Linux.</h2>
      <p class="m-0 text-lg text-fg2">Leave your name and email, and pick the systems you want. We write once, when each is ready.</p>
      <!-- A plain form that works without JavaScript: each ticked system is sent as `os` (worker/index.ts). -->
      <form id="waitlist" method="post" action="/api/waitlist" class="relative mt-2 flex w-full max-w-110 flex-col gap-4 text-left">
        <label class={label}>
          Name
          <input name="name" type="text" required maxlength="100" autocomplete="name" class={field} />
        </label>
        <label class={label}>
          Email
          <input name="email" type="email" required maxlength="254" autocomplete="email" class={field} />
        </label>
        <fieldset class="m-0 border-0 p-0">
          <legend class="mb-1.5 p-0 text-[13px] text-fg3">Which system? Pick one or both.</legend>
          <div class="grid grid-cols-2 gap-3">
            {
              systems.map(({ value, name }) => (
                <label class={toggle}>
                  <input type="checkbox" name="os" value={value} class="sr-only" />
                  {name}
                </label>
              ))
            }
          </div>
        </fieldset>
        <!-- Never seen by people; a bot that fills it is kept out. -->
        <div aria-hidden="true" class="absolute left-[-9999px] h-px w-px overflow-hidden">
          <label>Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>
        <!-- Where this person came from, filled by Measure.astro; empty without JavaScript. -->
        {landingFields.map((name) => <input type="hidden" name={name} />)}
        <button type="submit" class={`${primary} w-full cursor-pointer justify-center border-0`}>Join Now</button>
        <p class="m-0 text-center text-[13px] text-fg3">
          Kept only for this, never shared. <a href="/privacy#waitlist" class="text-fg3 underline underline-offset-[3px] hover:text-fg">Privacy</a>
        </p>
      </form>
    </div>
  </section>

  <section class="px-6 py-35">
    <div class="relative mx-auto max-w-290 overflow-hidden rounded-[20px] border border-line bg-chrome px-8 py-18 text-center">
      <div
        aria-hidden="true"
        class="absolute -bottom-55 left-1/2 h-90 w-190 -translate-x-1/2 opacity-[0.28] blur-[30px]"
        style="background: radial-gradient(closest-side, var(--glow), transparent);"
      >
      </div>
      <div class="relative flex flex-col items-center gap-5">
        <h2 class="m-0 text-[clamp(36px,5vw,56px)] font-semibold leading-[1.02] tracking-[-0.04em]">Open your data in seconds.</h2>
        <p class="m-0 text-lg text-fg2">Open source under AGPL-3.0. No telemetry.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={DOWNLOAD} class={primary}>Download for Windows</a>
          <a href={REPOSITORY} class={secondary}>Read the source</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Without JavaScript the Worker turns away a form with no system ticked (/waitlist/failed); with it,
  // the browser says so on the spot, as it does for an empty name.
  const form = document.getElementById("waitlist");
  if (form instanceof HTMLFormElement) {
    const boxes = [...form.querySelectorAll<HTMLInputElement>('input[name="os"]')];
    const check = () => boxes[0]?.setCustomValidity(boxes.some((box) => box.checked) ? "" : "Pick macOS, Linux or both.");
    for (const box of boxes) box.addEventListener("change", check);
    check();
  }
</script>
