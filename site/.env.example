# Copy to site/.env (git ignores it) so Wrangler in site/ always works on Kemable's Cloudflare
# account, whatever account `wrangler login` is on for other projects (site/README.md, The Kemable account).
# Wrangler reads this file in site/; a token here wins over the login.

# A token of Kemable's account with Account › D1 › Edit (site/README.md says how to make it).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=6473bcbb74cafb5f4543fa258985ffd3

# Keep this file's values out of the Worker that `wrangler dev` runs: they are Wrangler's, not the site's.
CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false
